MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dsa-tracker?retryWrites=true&w=majority
JWT_SECRET=change-me

# LeetCode Streak Automation (optional module)
# Dedicated key for encrypting browser session storageState (32+ chars recommended).
# Falls back to JWT_SECRET if unset — use a separate key in production.
AUTOMATION_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Shared secret for POST /api/automation cron ticks (header: x-cron-secret)
AUTOMATION_CRON_SECRET=change-me-cron-secret

# Opt-in Playwright submissions (may violate LeetCode ToS). Default is reminder-only.
# AUTOMATION_ALLOW_PLAYWRIGHT=true

# Email notifications via Resend (optional)
# RESEND_API_KEY=re_xxx
# AUTOMATION_EMAIL_FROM=onboarding@resend.dev
